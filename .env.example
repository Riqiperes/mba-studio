# =============================================================================
# mba-studio - variables de entorno
# =============================================================================
# Copiar este archivo a .env (raiz), o a apps/web/.env y apps/admin/.env segun
# corresponda, y llenar los valores reales. NUNCA subir .env con secretos
# reales al repositorio.
#
# Las variables con prefijo VITE_ son publicas: Vite las incluye en el bundle
# del navegador. No poner secretos ahi. Las variables sin prefijo VITE_ solo
# se usan en Supabase Edge Functions (server-side) y deben configurarse en el
# dashboard de Supabase (Project Settings -> Edge Functions -> Secrets), no en
# el frontend.
# =============================================================================

# --- Supabase (frontend: apps/web y apps/admin) ---------------------------
# URL del proyecto Supabase. Ver: Supabase Dashboard > Project Settings > API
VITE_SUPABASE_URL=

# Anon/public key del proyecto. Segura para exponer en el frontend porque
# el acceso real esta protegido por Row Level Security (RLS).
VITE_SUPABASE_ANON_KEY=

# --- Supabase (Edge Functions / server-side, NUNCA en el frontend) --------
# Service role key: acceso total, bypassa RLS. Solo se usa dentro de Edge
# Functions (supabase/functions/**). Configurar como secret en Supabase, no
# en .env del frontend.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_URL=

# --- Stripe -----------------------------------------------------------------
# Publishable key: segura para el frontend, se usa para redirigir a Stripe
# Checkout.
VITE_STRIPE_PUBLIC_KEY=

# Secret key: solo Edge Functions. Nunca en el frontend ni en VITE_*.
STRIPE_SECRET_KEY=

# Webhook signing secret, generado al crear el webhook endpoint en Stripe.
# Se usa para verificar la firma de cada evento antes de otorgar creditos.
STRIPE_WEBHOOK_SECRET=

# --- WhatsApp -----------------------------------------------------------------
# Proveedor activo. Valores soportados por el NotificationProvider:
#   mock  -> no envia nada real, solo loguea (default en desarrollo)
#   meta  -> Meta Cloud API
#   twilio -> Twilio WhatsApp API
#   ultramsg -> UltraMsg
WHATSAPP_PROVIDER=mock
WHATSAPP_API_KEY=
WHATSAPP_PHONE_NUMBER_ID=

# --- Email --------------------------------------------------------------------
EMAIL_PROVIDER=mock
EMAIL_API_KEY=
EMAIL_FROM_ADDRESS=

# --- Google OAuth ---------------------------------------------------------
# El Client ID / Secret de Google se configuran directamente en el dashboard
# de Supabase Auth (Authentication > Providers > Google), no como variables
# de entorno del frontend. Ver docs/authentication.md.

# --- Configuracion general --------------------------------------------------
# Entorno actual, usado solo para logging/behavior no critico.
VITE_APP_ENV=development
